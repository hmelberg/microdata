# microdata — delt token gir tilgang til AI-edge-funksjonene (M2PY_ACCESS_TOKEN)
# Local secrets for `netlify dev` ONLY — never deployed. For the live site,
# set the same names in the Netlify UI (Site configuration → Environment
# variables) or with: netlify env:set NAME 'verdi'

M2PY_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# Personlig passord-nivå (valgfritt): matcher Bearer-tokenet
# M2PY_ACCESS_TOKEN_PERSONAL brukes ANTHROPIC_API_KEY_PERSONAL i stedet for
# den delte nøkkelen over. BEGGE må settes — personlig passord uten personlig
# nøkkel er 500 med vilje (aldri stille fallback til delt regning).
M2PY_ACCESS_TOKEN_PERSONAL=
ANTHROPIC_API_KEY_PERSONAL=
# Kun for identitetskoblede nøkler (vanlige workspace-nøkler trenger den ikke).
ANTHROPIC_WORKSPACE_ID=
# Modell-overstyringer. Disse SLÅR brukerens kvalitetsvalg (Rask/Balansert/
# Best) — la dem stå tomme med mindre du bevisst vil pinne en modell.
# Defaults uten overstyring: claude-sonnet-5 (generering, dm-vurder,
# data-svar), claude-sonnet-5 m/lavere effort (tolk-resultat),
# claude-haiku-4-5 (variabelvelgeren i kode-svar-v2, ALDRI med effort —
# effort er en 400-feil på Haiku).
ANTHROPIC_MODEL=
DATA_SVAR_MODEL=
PICKER_MODEL=
M2PY_ANVIL_VALIDATE_URL=
